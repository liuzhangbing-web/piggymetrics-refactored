#!/usr/bin/env python3
"""SkyWalking alarm smoke test:
1. Query current alarm history via OAP GraphQL (correct 10.x schema).
2. Temporarily lower account-service RT threshold to 1ms (alarm must fire under real traffic).
3. Restart OAP (alarm-settings.yml is a mounted volume -> reload), generate traffic, wait ~3 cycles.
4. Verify alarm fired for account-service, then restore original threshold + restart OAP.
"""
import json, time, urllib.request, urllib.error, subprocess, sys, os

OAP = "http://localhost:12800/graphql"
ROOT = "/Users/liuzhangbing/Downloads/D/workspace_tke/piggymetrics-refactored"
ALARM = ROOT + "/skywalking/alarm-settings.yml"
GW = "http://localhost:4000"


def gql(query, variables=None):
    body = json.dumps({"query": query, "variables": variables or {}}).encode()
    req = urllib.request.Request(OAP, data=body, headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            return r.status, json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read().decode() or "{}")


def win(minus=60):
    e = time.gmtime(time.time()); s = time.gmtime(time.time() - minus * 60)
    return time.strftime("%Y-%m-%d %H%M", s), time.strftime("%Y-%m-%d %H%M", e)


def query_alarms(label):
    start, end = win()
    st, d = gql('''query q($d: Duration!) { getAlarmMessage(duration: $d, scope: Service,
        paging: {pageNum: 1, pageSize: 20}) { messages { key scope alarmMessage startTime } } }''',
                {"d": {"start": start, "end": end, "step": "MINUTE"}})
    msgs = []
    try:
        msgs = d["data"]["getAlarmMessage"]["messages"]
    except Exception:
        pass
    print(f"[{label}] alarms={len(msgs)}")
    for m in msgs[:10]:
        print("   -", m.get("alarmMessage", "")[:100])
    return msgs


def traffic(rounds=10):
    codes = {}
    for i in range(rounds):
        for path in ["/accounts/current", "/statistics/current", "/actuator/health"]:
            try:
                with urllib.request.urlopen(GW + path, timeout=10) as r:
                    codes[r.status] = codes.get(r.status, 0) + 1
            except urllib.error.HTTPError as e:
                codes[e.code] = codes.get(e.code, 0) + 1
            except Exception:
                codes["err"] = codes.get("err", 0) + 1
    return codes


def restart_oap():
    subprocess.run(["docker", "restart", "skywalking-oap"], capture_output=True, timeout=60)
    for _ in range(40):
        try:
            st = subprocess.run(["docker", "inspect", "--format", "{{.State.Health.Status}}", "skywalking-oap"],
                                capture_output=True, text=True, timeout=10).stdout.strip()
        except Exception:
            st = "?"
        if st == "healthy":
            return True
        time.sleep(5)
    return False


def main():
    orig = open(ALARM).read()

    print("=== STEP 1: 基线告警历史（生产阈值，应无告警）===")
    base = query_alarms("baseline")

    print("\n=== STEP 2: 临时将 account-service RT 阈值降为 1ms ===")
    t = orig.replace("expression: sum(service_resp_time > 800) >= 3",
                     "expression: sum(service_resp_time > 1) >= 3")
    t = t.replace("period: 10\n    silence-period: 10\n    # 仅对 account-service 生效",
                  "period: 2\n    silence-period: 2\n    # 仅对 account-service 生效")
    assert t != orig, "threshold replacement failed"
    open(ALARM, "w").write(t)
    print("  alarm-settings.yml patched (>1ms, period=2min); restarting OAP to reload...")
    ok = restart_oap()
    print("  OAP healthy after restart:", ok)
    if not ok:
        open(ALARM, "w").write(orig); print("RESTORE on failure"); sys.exit(1)

    print("\n=== STEP 3: 打流量并等待 2 个统计周期（~5min）===")
    print("  traffic:", traffic(20))
    fired = []
    for cycle in range(7):
        time.sleep(50)
        traffic(8)  # keep account-service metrics fresh each window
        fired = query_alarms(f"cycle-{cycle}")
        hit = [m for m in fired if "account-service" in json.dumps(m) or "800ms" in json.dumps(m)
               or ">1ms" in json.dumps(m) or "账务" in json.dumps(m)]
        if hit:
            print("  *** ALARM FIRED for account-service ***")
            for m in hit[:5]:
                print("   -", m.get("alarmMessage", "")[:120])
            break
    else:
        hit = []

    print("\n=== STEP 4: 还原生产阈值并重启 OAP ===")
    open(ALARM, "w").write(orig)
    ok2 = restart_oap()
    print("  restored + OAP healthy:", ok2)

    print("\nRESULT:", "ALARM_FIRED_OK" if hit else "ALARM_NOT_FIRED")
    sys.exit(0 if hit else 2)


if __name__ == "__main__":
    main()
