# copy to .env and fill real values. NEVER commit .env (already in .gitignore).
#
# 生成合法的 NACOS_AUTH_TOKEN（Nacos 3.x 强制要求：Base64 字符串，解码后 >=32 字节）：
#   python3 -c "import base64;print(base64.b64encode(b'<至少64字符的随机密钥串>').decode())"
# 缺失或非法会导致 nacos 容器启动即退出（env NACOS_AUTH_TOKEN must be set with Base64 String）。
#
# NACOS_AUTH_IDENTITY_KEY/VALUE 必须与 docker-compose.yml 及 provision/verify 脚本中
# 的 identity header 一致（默认 serverIdentityKey / serverIdentityValue）。

MONGODB_PASSWORD=***
ACCOUNT_SERVICE_PASSWORD=***
STATISTICS_SERVICE_PASSWORD=***
NOTIFICATION_SERVICE_PASSWORD=***
CONFIG_SERVICE_PASSWORD=***
NACOS_AUTH_TOKEN=<Base64…上生成>
NACOS_AUTH_IDENTITY_KEY=serverIdentityKey
NACOS_AUTH_IDENTITY_VALUE=serverIdentityValue
